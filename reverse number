public class reveersenum{
    public int reverseNum (int n){
        int rev =0;
        while(n>0){
            int rem =n%10;
            rev=rev*10+rem;                                                                             
            n = n/10;
        }
            return rev;
        
    }
    public static void main(String[] args) {
        reveersenum obj = new reveersenum();
        System.out.println("rev of 1234  is "+obj.reverseNum(1234));
        System.out.println("rev of 2765  is "+obj.reverseNum(5672));
       
       

    }

}
